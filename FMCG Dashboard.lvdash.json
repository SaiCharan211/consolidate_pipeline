{
  "datasets": [
    {
      "name": "4b6be328",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "time_period",
            "expr": "CASE WHEN granularity = 'Year' THEN DATE_TRUNC('YEAR', source.date) ELSE DATE_TRUNC('MONTH', source.date) END",
            "displayName": "Time Period"
          },
          {
            "expr": "source.*"
          }
        ],
        "parameters": [
          {
            "name": "granularity",
            "dataType": "STRING",
            "default": "'Month'"
          }
        ]
      }
    },
    {
      "name": "top_10_products",
      "displayName": "Top 10 Products",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  SUM(total_amount_inr) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  product\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_10_customers",
      "displayName": "Top 10 Customers",
      "queryLines": [
        "SELECT\n",
        "  customer,\n",
        "  SUM(total_amount_inr) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  customer\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_10_customers_details",
      "displayName": "Top 10 Customers Details",
      "queryLines": [
        "SELECT\n",
        "  customer,\n",
        "  SUM(sold_quantity) as total_quantity,\n",
        "  SUM(total_amount_inr) as total_revenue\n",
        "FROM\n",
        "  fmcg.gold.vw_fact_orders_enriched\n",
        "GROUP BY\n",
        "  customer\n",
        "ORDER BY\n",
        "  total_revenue DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "granularity_opts",
      "displayName": "Granularity Options",
      "config": {
        "version": "1.1",
        "source": "SELECT 'Month' AS opt UNION ALL SELECT 'Year' AS opt\n",
        "dimensions": [
          {
            "name": "label",
            "expr": "opt"
          }
        ]
      }
    }
  ],
